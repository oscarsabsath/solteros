# ========================================================
# CONFIGURACIÓN DE GOOGLE FIREBASE (GOOGLE CLOUD)
# 1. Ve a https://console.firebase.google.com
# 2. Crea un proyecto (ej: "solteros-adventistas")
# 3. En Configuración del proyecto -> Tus apps (Web </>), copia:
# ========================================================
VITE_FIREBASE_API_KEY=tu-api-key-de-firebase
VITE_FIREBASE_AUTH_DOMAIN=solteros-adventistas.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=solteros-adventistas

# ========================================================
# O CONFIGURACIÓN DE SUPABASE
# ========================================================
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-clave-anon
